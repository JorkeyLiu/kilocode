#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'
NC='\033[0m'

cat >&2 <<'EOF'
Kilo Code standalone CLI installer is retired.

Kilo Code is now distributed exclusively as the VS Code extension
(kilocode.kilo-code), which bundles the `kilo-serve` runtime.

  VS Code Marketplace: https://marketplace.visualstudio.com/items?itemName=kilocode.kilo-code
  Open VSX:            https://open-vsx.org/extension/kilocode/Kilo-Code
  Documentation:       https://kilo.ai/docs

The installer at https://kilo.ai/cli/install and the GitHub release
archives / npm package @kilocode/cli are no longer published. This
script no longer downloads or installs anything and exits with an
error to avoid silently providing stale artifacts.

Your existing installation at ~/.kilo/bin/kilo (if any) has been left
intact and will continue to work but will not receive updates via this
script. To obtain the current runtime, install or update the VS Code
extension; the extension bundles `kilo-serve` per platform into the
VSIX and does not use this installer.

For local development, build the bundled runtime from source:

  bun run --cwd packages/opencode --conditions=browser src/index.ts
  bun run --cwd packages/kilo-vscode package

EOF

# Preserve --help / --version handling with the same retired notice (non-zero exit)
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "" >&2
  echo "This installer no longer supports options (--version, --binary, --no-modify-path)." >&2
  echo "Install the VS Code extension instead (see links above)." >&2
fi

echo -e "${RED}Error: standalone CLI install via https://kilo.ai/cli/install is no longer supported.${NC}" >&2
exit 1
